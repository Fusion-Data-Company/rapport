# ── Database (Neon Postgres) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used for Stripe redirects and unsubscribe links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
# Recurring monthly price for one seat ($29/seat/month). Quantity = seats.
STRIPE_PRICE_ID=price_xxx
# Signing secret for the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Cron + email links ───────────────────────────────────────────────────────
# Bearer token required by /api/cron/* (Vercel Cron sends it automatically).
CRON_SECRET=change-me
# HMAC secret for unsubscribe links. Falls back to CRON_SECRET when unset.
UNSUBSCRIBE_SECRET=change-me-too

# ── Outbound email (default when a tenant has not configured their own) ──────
RESEND_API_KEY=re_xxx

# ── AI (default when a tenant has not configured their own key) ──────────────
OPENROUTER_API_KEY=sk-or-xxx

# ── Card image uploads (Vercel Blob) ─────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── Paige voice widget (optional) ────────────────────────────────────────────
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
