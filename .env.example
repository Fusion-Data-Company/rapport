# ── Secrets at rest ──────────────────────────────────────────────────────────
# 32 bytes, base64 or hex. Seals SMTP passwords, OAuth refresh tokens and LLM keys.
ENCRYPTION_KEY=

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used for Stripe redirects and unsubscribe links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
# Recurring monthly price for one seat ($29/seat/month). Quantity = seats.
STRIPE_PRICE_ID=price_xxx
# Signing secret for the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Cron + email links ───────────────────────────────────────────────────────
# Bearer token required by /api/cron/* (Vercel Cron sends it automatically).
CRON_SECRET=change-me
# HMAC secret for unsubscribe links. Falls back to CRON_SECRET when unset.
UNSUBSCRIBE_SECRET=change-me-too

# ── Outbound email ───────────────────────────────────────────────────────────
# Preferred: the agent connects their own mailbox with one click and Rapport sends
# through the Gmail API / Microsoft Graph on a send-only grant. Leave these unset and
# the buttons are shown as unavailable; SMTP below still works.
# Google Cloud console, OAuth client (Web). Redirect: <APP_URL>/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Entra ID app registration. Redirect: <APP_URL>/api/oauth/microsoft/callback
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# Platform fallback mailbox for trials that have not connected their own (optional)
SMTP_URL=smtp://user:pass@smtp.example.com:587

# ── AI (default when a tenant has not configured their own key) ──────────────
# Text drafting only. Images never go through here - the card engine is Higgsfield.
OPENROUTER_API_KEY=sk-or-xxx

# ── Card image uploads (Vercel Blob) ─────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── Paige voice widget (optional) ────────────────────────────────────────────
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Demo deployment: new tenants get a fictional sample book and a demo bar
NEXT_PUBLIC_DEMO_MODE=false

# ── Card generation (Higgsfield server API) ──────────────────────────────────
# Rapport generates the card at send time, with the contact name printed on it.
# Server-side key pair from cloud.higgsfield.ai. Without these, every note falls
# back to the named system card for the occasion and nothing breaks.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Optional overrides. Defaults: https://api.higgsfield.ai, the documented model path,
# and 4:5 - the ratio the shipped set was rendered at.
# HIGGSFIELD_API_BASE=https://api.higgsfield.ai
# HIGGSFIELD_CARD_MODEL=higgsfield-ai/soul/v2/standard
# HIGGSFIELD_CARD_RATIO=4:5
